# MongoDB connection string (required)
MONGO_URI=mongodb://localhost:27017/
# Optional: database name (default: ResumeAnalyzer)
# MONGO_DB_NAME=ResumeAnalyzer

# Google Gemini API key (required to parse and rank resumes)
GOOGLE_API_KEY=
# Optional: Gemini model (default: gemini-2.5-flash-lite)
# GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: LangSmith tracing (enabled automatically when a key is set)
# LANGSMITH_API_KEY=
